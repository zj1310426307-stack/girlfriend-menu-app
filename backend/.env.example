# 留空或删除 DATABASE_URL 时，本地默认使用 backend/girlfriend_menu.db
DATABASE_URL=sqlite:///./girlfriend_menu.db
# 微信小程序不需要 FRONTEND_URL。仅在未来增加获准的浏览器客户端时填写。
FRONTEND_URL=
ADMIN_PASSWORD=admin123
ADMIN_INVITE_CODE=love2026
ADMIN_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN_VERSION=1
CUSTOMER_INVITE_CODE=love2026
ALLOW_LEGACY_CUSTOMER_HEADER=false
APP_ENV=development
UPLOAD_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# 可选：配置后用于游戏热状态、在线状态和跨进程断线恢复；不配置时 PostgreSQL 仍可独立运行。
REDIS_URL=
GAME_ROOM_LEASE_SECONDS=30
GAME_INSTANCE_ID=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
