# 留空或删除 DATABASE_URL 时，本地默认使用 backend/girlfriend_menu.db
DATABASE_URL=sqlite:///./girlfriend_menu.db
# 微信小程序不需要 FRONTEND_URL。仅在未来增加获准的浏览器客户端时填写。
FRONTEND_URL=
# 管理凭据必须显式配置。仅兼容迁移时使用 ADMIN_PASSWORD；新部署优先使用下方散列。
ADMIN_PASSWORD=
# 在仓库根目录运行 backend/.venv/Scripts/python.exe scripts/hash_admin_password.py 生成，只保存在后端 Secret 中。
ADMIN_PASSWORD_HASH=
# 管理邀请码与客户邀请码必须分别生成、不得相同。
ADMIN_INVITE_CODE=
# 使用 Python secrets.token_urlsafe(48) 生成独立随机值，不得使用示例文本。
ADMIN_SECRET=
ADMIN_TOKEN_VERSION=1
CUSTOMER_INVITE_CODE=
CUSTOMER_SESSION_TTL_DAYS=90
ALLOW_LEGACY_CUSTOMER_HEADER=false
# 标准微信登录；AppSecret 必须从微信后台显式配置在后端，绝不能写入小程序源码。
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
APP_ENV=development
UPLOAD_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# 可选：配置后用于游戏热状态、在线状态和跨进程断线恢复；不配置时 PostgreSQL 仍可独立运行。
REDIS_URL=
GAME_ROOM_LEASE_SECONDS=30
GAME_INSTANCE_ID=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
