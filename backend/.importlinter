[importlinter]
root_packages =
    ai
    api
    games
    repositories
    services
include_external_packages = True

[importlinter:contract:repositories-boundary]
name = Repositories do not depend on API or service orchestration
type = forbidden
source_modules =
    repositories
forbidden_modules =
    api
    services
    notification_service

[importlinter:contract:pure-game-rules]
name = Pure game rules do not depend on web or persistence frameworks
type = forbidden
source_modules =
    games.*.rule
    games.*.engine
    games.*.ai
forbidden_modules =
    fastapi
    sqlalchemy
    database
    models
as_packages = False

[importlinter:contract:api-does-not-query-repositories]
name = API routes use services instead of repository internals
type = forbidden
source_modules =
    api.routes
forbidden_modules =
    repositories
allow_indirect_imports = True

[importlinter:contract:services-do-not-depend-on-api]
name = Services remain independent from HTTP presentation
type = forbidden
source_modules =
    services
forbidden_modules =
    api

[importlinter:contract:local-ai-is-framework-free]
name = Local game AI does not depend on web or persistence frameworks
type = forbidden
source_modules =
    ai
forbidden_modules =
    fastapi
    sqlalchemy
    database
    models
