{
  "name": "girlfriend-menu-miniprogram",
  "version": "3.0.0",
  "private": true,
  "description": "情侣智能厨房管家微信小程序端",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:weapp:staging": "taro build --type weapp --env production --mode staging",
    "dev:weapp": "taro build --type weapp --watch",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:v24": "node scripts/v24-smoke-test.cjs",
    "test:v25": "node scripts/v25-smoke-test.cjs",
    "test:v26": "node scripts/v26-smoke-test.cjs",
    "test:v27": "node scripts/v27-smoke-test.cjs",
    "test:v28": "node scripts/v27-smoke-test.cjs",
    "test:landlord": "node scripts/landlord-landscape-config-test.cjs",
    "test:games": "node scripts/game-longevity-test.cjs && node scripts/game-socket-test.cjs",
    "test:ci": "npm run test:landlord && npm run test:games && npm run test:session && npm run test:v3-architecture && npm run test:product-flow && npm run test:launch && npm run test:tabs && npm run test:devtools-contract",
    "test:game-pages:devtools": "node scripts/game-pages-devtools-acceptance.cjs",
    "test:devtools-contract": "node scripts/game-pages-devtools-contract-test.cjs",
    "test:dist": "node scripts/weapp-dist-integrity-test.cjs",
    "test:session": "node scripts/customer-session-contract-test.cjs && node scripts/session-owned-storage-behavior-test.cjs",
    "test:v3-architecture": "node scripts/v3-architecture-test.cjs",
    "test:product-flow": "node scripts/product-core-flow-test.cjs",
    "test:launch": "node scripts/home-launch-performance-contract-test.cjs",
    "test:tabs": "node scripts/tab-launch-performance-contract-test.cjs",
    "test:landlord:devtools": "node scripts/landlord-landscape-smoke.cjs",
    "test:dice": "node scripts/smoke-test.cjs --dice-only",
    "preview:dice": "node scripts/smoke-test.cjs --dice-only --keep-open",
    "preview:cup": "node scripts/smoke-test.cjs --dice-only --keep-open --stop-before-open"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@tarojs/components": "^4.2.0",
    "@tarojs/helper": "^4.2.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/shared": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-react": "^7.25.9",
    "@tarojs/cli": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "babel-preset-taro": "^4.2.0",
    "miniprogram-automator": "^0.12.1",
    "webpack": "^5.91.0"
  }
}
